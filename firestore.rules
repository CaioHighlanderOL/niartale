rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isMaster() {
      return signedIn() && userDoc().data.role == "master";
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == "player";
      allow read: if signedIn() && (request.auth.uid == uid || isMaster());
      allow update: if signedIn() && (
        (
          request.auth.uid == uid
          && request.resource.data.role == resource.data.role
        )
        || isMaster()
      );
      allow delete: if false;
    }

    match /campaigns/{campaignId} {
      allow read: if signedIn();
      allow create: if signedIn() && campaignId == "default";
      allow update, delete: if isMaster();
    }

    match /characters/{characterId} {
      allow create: if signedIn() && (
        request.resource.data.ownerId == request.auth.uid || isMaster()
      );
      allow read, update, delete: if signedIn() && (
        resource.data.ownerId == request.auth.uid || isMaster()
      );
    }

    match /diceLog/{rollId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isMaster();
    }
  }
}
