rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function isMaster() {
      return signedIn() && userDoc().data.role == "master";
    }

    function characterDoc(characterId) {
      return firestore.get(/databases/(default)/documents/characters/$(characterId));
    }

    function canAccessCharacter(characterId) {
      return signedIn()
        && (
          characterDoc(characterId).data.ownerId == request.auth.uid
          || isMaster()
        );
    }

    function validPdfUpload() {
      return request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType == "application/pdf";
    }

    match /characters/{characterId}/documents/{fileName} {
      allow read, delete: if canAccessCharacter(characterId);
      allow create, update: if canAccessCharacter(characterId) && validPdfUpload();
    }
  }
}
